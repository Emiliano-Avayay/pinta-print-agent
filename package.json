{
  "name": "pinta-print-agent",
  "version": "0.2.0",
  "private": true,
  "description": "Local, durable kitchen print agent for Pinta",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "demo:fake": "tsx scripts/fake-backend-demo.ts",
    "escpos:demo": "tsx scripts/escpos-demo.ts",
    "printer:test": "tsx scripts/printer-test.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "installer:prepare": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File installer/prepare.ps1",
    "installer:preflight": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File installer/prepare.ps1 -PreflightOnly",
    "installer:win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File installer/build.ps1",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint .",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
